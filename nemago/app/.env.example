# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your real values never get committed.
# Put the same values in Vercel: Project -> Settings -> Environment Variables.

# Supabase: Project Settings -> API (the URL and the publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# SECRET values below. Server only: never add NEXT_PUBLIC_ to them, never commit
# real values, never paste them in chat.
# Supabase secret key (bypasses all security rules): Project Settings -> API keys
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
# Stripe TEST secret key: Developers -> API keys. Must start with sk_test_
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
# Stripe webhook signing secret: Developers -> Webhooks -> your endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Public address of the app (used for the links Stripe sends people back to)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
